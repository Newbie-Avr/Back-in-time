# Back in Time — Optional Environment Configuration
# Default values are used automatically if this file is not present.

# Local Web Server Port (Default: 3000)
PORT=3000

# Local LM Studio API Base URL (Default: http://127.0.0.1:1234/v1)
# Note: For security and privacy, this must point to a local loopback address.
LM_STUDIO_URL=http://127.0.0.1:1234/v1
